{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>maxexcloo/dotfiles//renovate/default.json5"],
  // Only lines a patch adds may change; removed and context lines must still
  // match upstream for the patch to apply.
  customManagers: [
    {
      customType: "regex",
      datasourceTemplate: "github-releases",
      description: "GitHub release assets added by patches",
      managerFilePatterns: ["/\\.patch$/"],
      matchStrings: [
        "\\n\\+[^\\n]*https://github\\.com/(?<depName>[^/\\s]+/[^/\\s]+)/releases/download/(?<currentValue>[^/\\s]+)/",
      ],
    },
    {
      customType: "regex",
      datasourceTemplate: "git-refs",
      description: "Git dependencies added by patches follow the default branch",
      managerFilePatterns: ["/\\.patch$/"],
      matchStrings: [
        "\\n\\+[^\\n]*https://github\\.com/(?<depName>[^/\\s]+/[^/\\s]+?)\\.git#(?<currentDigest>[a-f0-9]{40})",
      ],
      packageNameTemplate: "https://github.com/{{depName}}",
    },
  ],
  packageRules: [
    {
      description: "Stay within the reviewed major; -N fix releases rank above their base release",
      matchDepNames: ["pioarduino/platform-espressif32"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:-(?<build>\\d+))?$",
    },
    {
      enabled: false,
      matchDepNames: ["pioarduino/platform-espressif32"],
      matchUpdateTypes: ["major"],
    },
    {
      matchDepNames: ["esp-web-tools"],
      postUpgradeTasks: {
        commands: ["scripts/vendor_esp_web_tools.sh"],
        fileFilters: ["site/vendor/esp-web-tools/**"],
      },
    },
  ],
}
